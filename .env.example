# GenreGuru required environment variables.
#
# Secrets resolve via Hydra `${oc.env:...}` interpolation at load time and are
# NEVER committed to YAML. Copy this file to `.env` and fill real values.

# Selects the Hydra logging/db/django config groups. Set to `prod` in
# production; defaults to `dev`, so local runs need not set it.
GENREGURU_ENV=dev

# SQLAlchemy / psycopg database URL. Used by config/db/prod.yaml via
# `${oc.env:DATABASE_URL}`. The dev group (config/db/dev.yaml) ships a local
# default and can be overridden at runtime: `python -m genreguru.db.init_db db.url=...`
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genreguru

# Django signing / session secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me

# Django production settings (DJANGO_SETTINGS_MODULE=genreguru_web.settings.production).
# Comma-separated hostnames. Required, no default -- production fails closed.
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
