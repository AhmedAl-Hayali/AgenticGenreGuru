# Hydra environment group — selects config/django/prod.yaml, config/db/prod.yaml,
# config/logging/prod.yaml.
GENREGURU_ENV=prod

# Django settings module — production.py sets GENREGURU_ENV=prod and loads
# the prod config groups via base.py → get_config().
DJANGO_SETTINGS_MODULE=genreguru_web.settings.production

# Database connection components. config/db/prod.yaml resolves `${oc.env:DB_*}`;
# user/password/host/port have NO default there and production fails closed.
# The dev group (config/db/dev.yaml) ships local defaults, overridable at
# runtime: `uv run python -m genreguru.db.init_db db.host=... db.port=...`
DB_DIALECT=postgresql
DB_DRIVER=psycopg
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=genreguru

# Django signing / session secret. Generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me

# Django production settings (DJANGO_SETTINGS_MODULE=genreguru_web.settings.production).
# Comma-separated hostnames. Required, no default -- production fails closed.
# For local Docker, include service names.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
