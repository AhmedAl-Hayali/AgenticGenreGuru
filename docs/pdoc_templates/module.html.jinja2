{% extends "default/module.html.jinja2" %}

{% block module_info %}
    <section class="module-info">
        {% block edit_button %}
            {{ super() }}
        {% endblock %}
        {{ module_name() }}
        {{ docstring(module) }}

        {% if module.modulename in ["genreguru", "genreguru_web", "fingerprint_app"] %}
            {% set purposes_by_pkg = {
                "genreguru": {
                    "genreguru.audio": "Audio package: loader, `Feature` enum, extract + collapse.",
                    "genreguru.audio.features": "`Feature` enum — the single source of the 8 acoustic feature names.",
                    "genreguru.audio.feature_extract": "8-feature DSP extraction → raw per-frame ndarrays (shared STFT).",
                    "genreguru.audio.feature_collapse": "Arithmetic-mean collapse to a scalar per feature.",
                    "genreguru.audio.loader": "Audio snippet loading + mono downmix + format validation.",
                    "genreguru.config": "Hydra config composition (Django-safe, cwd-independent).",
                    "genreguru.db.base": "Declarative base, `TimestampedMixin`, `UuidMixin`.",
                    "genreguru.db.engine": "SQLAlchemy engine creation and session-factory lifecycle.",
                    "genreguru.db.init_db": "Idempotent table-creation entrypoint (`uv run python -m genreguru.db.init_db`).",
                    "genreguru.db.models": "`Song` and `SongFingerprint` ORM models (PostgreSQL 18 `uuidv7()`).",
                    "genreguru.db.repositories": "`SongRepository` persistence with deduplication-by-ISRC.",
                    "genreguru.deezer": "Deezer API integration: search client + snippet fetcher with retry.",
                    "genreguru.deezer.client": "`DeezerClient.search()` + error-code classification.",
                    "genreguru.deezer.snippets": "Preview snippet fetch with 3x retry / 5s delay.",
                    "genreguru.dto": "Transport DTOs (Artist, Album, DeezerTrack, FeatureScalars, ...).",
                    "genreguru.errors": "Domain exception hierarchy with structured `context()` for log enrichment.",
                    "genreguru.fingerprint_service": "US1 orchestration: ISRC reuse short-circuit, else fetch → extract → store.",
                    "genreguru.gglogging": "Centralized logging: `LoggingManager`, `JsonFormatter`, `FingerprintContextAdapter`.",
                },
                "genreguru_web": {
                    "genreguru_web.asgi": "ASGI entry point for async server deployment.",
                    "genreguru_web.runtime": "One-time initialization: shared SQLAlchemy engine, logging setup.",
                    "genreguru_web.settings.base": "Shared base settings (Hydra compose; side-effect free).",
                    "genreguru_web.settings.development": "Local development settings (default).",
                    "genreguru_web.settings.production": "Deployed environment settings.",
                    "genreguru_web.settings.test": "CI and test runner settings.",
                    "genreguru_web.urls": "Root URL configuration.",
                    "genreguru_web.wsgi": "WSGI entry point for sync server deployment.",
                },
                "fingerprint_app": {
                    "fingerprint_app.admin": "Django admin configuration for fingerprint models.",
                    "fingerprint_app.apps": "Django app configuration.",
                    "fingerprint_app.migrations": "Database migration history.",
                    "fingerprint_app.models": "Fingerprint models for Django ORM integration.",
                    "fingerprint_app.urls": "App-level URL routing.",
                    "fingerprint_app.views": "Fingerprint search views and API endpoints.",
                },
            } %}
            <h2>Modules</h2>
            <table>
                <thead>
                    <tr><th>Module</th><th>Purpose</th></tr>
                </thead>
                <tbody>
                {% for submodule in all_modules
                        if "._" not in submodule
                        and not submodule.startswith("_")
                        and submodule.startswith(module.modulename + ".") %}
                    <tr>
                        <td><a href="{{ submodule.replace(".", "/") }}.html"><code>{{ submodule }}</code></a></td>
                        <td>{{ purposes_by_pkg[module.modulename].get(submodule, "See module docstring.") }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {{ view_source_state(module) }}
        {{ view_source_button(module) }}
        {{ view_source_code(module) }}
    </section>
{% endblock %}
